# Copy to runtime.env in the deployment directory and fill in real values.
# Generate PERPETO_ACCESS_TOKEN_KEY, PERPETO_MFA_KEY, and the bootstrap token
# with: bash scripts/dev-auth-env.sh

PERPETO_MODE=PAPER

# Required only for SANDBOX/SHADOW connector accounts (base64, 32 bytes).
# Exchange API credentials are imported through funding-arb-venue-admin stdin,
# never placed in this file.
PERPETO_SECRET_MASTER_KEY=
PERPETO_SCAN_INTERVAL_SECS=30
PERPETO_RECONCILE_INTERVAL_SECS=60

# Postgres container credentials
POSTGRES_USER=perpeto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=perpeto

# Application database connection (host is the compose service name)
DATABASE_URL=postgres://perpeto:change-me@postgres:5432/perpeto

# Access-token signing (base64 of a 32-byte Ed25519 seed)
PERPETO_ACCESS_TOKEN_KEY=
PERPETO_TOKEN_ISSUER=https://api.perpeto.xyz

# Provider identity-token audiences
PERPETO_APPLE_BUNDLE_ID=com.signex.mobile
PERPETO_GOOGLE_IOS_CLIENT_ID=753776627523-j1p1q51ug9q88ara0gj0ce4m52gjcs5e.apps.googleusercontent.com
PERPETO_GOOGLE_WEB_CLIENT_ID=753776627523-d5u5s1b1hna23gh8jo128fdo2357aap5.apps.googleusercontent.com

# One-use deployment bootstrap token (store SHA-256 hex, keep plaintext offline)
PERPETO_BOOTSTRAP_TOKEN_HASH=
PERPETO_BOOTSTRAP_TOKEN_EXPIRES_AT=2026-12-31T00:00:00Z

# TOTP secret encryption (base64 of a 32-byte AES-256-GCM key)
PERPETO_MFA_KEY=

# Interim v1 open registration (DEC-0009): true = new sign-ins get full access
# immediately with no pending approval or MFA. Set true on the shared dev/
# TestFlight backend; leave false for isolated/production deployments.
PERPETO_OPEN_REGISTRATION=true
