# Copy to runtime.env in the deployment directory and fill in real values.
# Generate SIGNEX_ACCESS_TOKEN_KEY, SIGNEX_MFA_KEY, and the bootstrap token
# with: bash scripts/dev-auth-env.sh

SIGNEX_MODE=PAPER

# Postgres container credentials
POSTGRES_USER=signex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=signex

# Application database connection (host is the compose service name)
DATABASE_URL=postgres://signex:change-me@postgres:5432/signex

# Access-token signing (base64 of a 32-byte Ed25519 seed)
SIGNEX_ACCESS_TOKEN_KEY=
SIGNEX_TOKEN_ISSUER=https://signex-api.sholaayeni.xyz

# Provider identity-token audiences
SIGNEX_APPLE_BUNDLE_ID=com.signex.mobile
SIGNEX_GOOGLE_IOS_CLIENT_ID=753776627523-j1p1q51ug9q88ara0gj0ce4m52gjcs5e.apps.googleusercontent.com
SIGNEX_GOOGLE_WEB_CLIENT_ID=753776627523-d5u5s1b1hna23gh8jo128fdo2357aap5.apps.googleusercontent.com

# One-use deployment bootstrap token (store SHA-256 hex, keep plaintext offline)
SIGNEX_BOOTSTRAP_TOKEN_HASH=
SIGNEX_BOOTSTRAP_TOKEN_EXPIRES_AT=2026-12-31T00:00:00Z

# TOTP secret encryption (base64 of a 32-byte AES-256-GCM key)
SIGNEX_MFA_KEY=
