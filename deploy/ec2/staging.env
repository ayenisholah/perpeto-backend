# Non-secret settings for the AWS PAPER staging host (DEC-0020).
# deploy/ec2/refresh.sh appends the secrets from Secrets Manager and writes the
# result to /opt/perpeto/runtime.env. Every value here is public.

PERPETO_MODE=PAPER

# Keyless public Binance, Bybit and OKX data on wall-clock time (DEC-0016).
PERPETO_PAPER_SOURCE=live
PERPETO_PAPER_UNDERLYINGS=BTC,ETH
PERPETO_MAX_SNAPSHOT_AGE_SECS=90
PERPETO_SCAN_INTERVAL_SECS=30
PERPETO_RECONCILE_INTERVAL_SECS=60

# Postgres superuser; used only to provision the two roles below.
POSTGRES_USER=perpeto
POSTGRES_DB=perpeto

PERPETO_TOKEN_ISSUER=https://api.perpeto.xyz

# Provider identity-token audiences (public client identifiers).
PERPETO_APPLE_BUNDLE_ID=com.signex.mobile
PERPETO_GOOGLE_IOS_CLIENT_ID=753776627523-j1p1q51ug9q88ara0gj0ce4m52gjcs5e.apps.googleusercontent.com
PERPETO_GOOGLE_WEB_CLIENT_ID=753776627523-d5u5s1b1hna23gh8jo128fdo2357aap5.apps.googleusercontent.com

# Shared TestFlight/staging backend (DEC-0009).
PERPETO_OPEN_REGISTRATION=true

# The read-only public demo (DEC-0017, DEC-0021): one seeded demo tenant served
# to the hosted web build at PERPETO_APP_DOMAIN. PAPER only.
PERPETO_DEMO_ENABLED=true
PERPETO_APP_DOMAIN=app.perpeto.xyz
