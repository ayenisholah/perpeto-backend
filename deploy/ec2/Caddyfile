# TLS front door for the AWS staging host (DEC-0020).
#
# PERPETO_PUBLIC_HOSTS lists api.perpeto.xyz and <elastic-ip>.sslip.io, so the
# API is reachable over HTTPS before and after its DNS record points here.
{$PERPETO_PUBLIC_HOSTS} {
	encode zstd gzip
	reverse_proxy api:8080
}

# The Next.js web platform (DEC-0021): app.perpeto.xyz and
# app.<elastic-ip>.sslip.io. Every request goes to the web server, whose
# backend-for-frontend calls the API over the compose network; the browser
# never holds an API token, so the API needs no CORS.
{$PERPETO_APP_HOSTS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	reverse_proxy web:3000
}
